{
  "name": "liquorstore",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "oxlint . --max-warnings 0",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "web": "expo start --web"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.95",
    "@expo-google-fonts/hanken-grotesk": "^0.4.3",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.10",
    "convex": "^1.46.0",
    "expo": "~57.0.25",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-location": "~57.0.20",
    "expo-secure-store": "~57.0.4",
    "expo-sensors": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^22.20.4",
    "@types/react": "~19.2.4",
    "convex-test": "^0.0.60",
    "eslint-plugin-react-native": "^5.0.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
